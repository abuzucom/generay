    },
    "C27.4": {
      "title": "Slewing, smearing, and precision sources",
      "class": "C27",
      "method": "both"
    },
    "C27.5": {
      "title": "Reference loss, holdover, and resynchronization",
      "class": "C27",
      "method": "llm"
    },
    "C27.6": {
      "title": "Sync differs by platform and environment",
      "class": "C27",
      "method": "both"
    },
    "C27.7": {
      "title": "Public pools are not authoritative time sources",
      "class": "C27",
      "method": "both"
    },
    "C27.8": {
      "title": "An NTP reply is a measurement with an error bound",
      "class": "C27",
      "method": "both"
    },
    "C27.9": {
      "title": "Government and national servers: stratum is not authority",
      "class": "C27",
      "method": "both"
    },
    "C27.10": {
      "title": "Nearest and lowest latency is not best",
      "class": "C27",
      "method": "both"
    },
    "C27.11": {
      "title": "Servers and attackers can shift time on purpose",
      "class": "C27",
      "method": "both"
    },
    "C27.12": {
      "title": "One government or operator is a single point of failure",
      "class": "C27",
      "method": "both"
    },
    "C27.13": {
      "title": "Sync must work over IPv6 and needed ports, not just IPv4",
      "class": "C27",
      "method": "heuristic"
    },
    "C27.14": {
      "title": "Servers stay silent, refuse, and rate-limit",
      "class": "C27",
      "method": "both"
    },
    "C27.15": {
      "title": "One or two sources cannot vote",
      "class": "C27",
      "method": "both"
    },
    "C27.16": {
      "title": "NTP does not replace the RTC, GNSS, or other sources",
      "class": "C27",
      "method": "both"
    },
    "C27.17": {
      "title": "Time distribution needs a hierarchy, not every node on its own",
      "class": "C27",
      "method": "both"
    },
    "C27.18": {
      "title": "External UTC is not the right clock for every job",
      "class": "C27",
      "method": "llm"
    },
    "C27.19": {
      "title": "GPS is not always available or right",
      "class": "C27",
      "method": "both"
    },
    "C27.20": {
      "title": "GPS hardware does not mean GPS sets the clock",
      "class": "C27",
      "method": "both"
    },
    "C27.21": {
      "title": "A GPS fix can still give the wrong time",
      "class": "C27",
      "method": "both"
    },
    "C27.22": {
      "title": "No single source should always win, including GPS",
      "class": "C27",
      "method": "both"
    },
    "C27.23": {
      "title": "Time services are attack surface and must be secured",
      "class": "C27",
      "method": "heuristic"
    },
    "C27.24": {
      "title": "RTC-only operation must be designed",
      "class": "C27",
      "method": "both"
    }
